{
  "ConnectionStrings": {
    "MealMateDb": "Host=localhost;Port=5432;Database=mealmate;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "https://api.mealmate.local",
    "Audience": "mealmate-clients",
    "SecretKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "LocalRoot": ""
  },
  "Seed": {
    "Identity": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Totp": {
    "Issuer": "MealMate Admin"
  },
  "AllowedHosts": "*"
}
