{
  "ConnectionStrings": {
    "MealMateDb": "PASTE_EXTERNAL_POSTGRES_CONNECTION_STRING_HERE"
  },
  "Jwt": {
    "Issuer": "https://site83043.siteasp.net",
    "Audience": "mealmate-clients",
    "SecretKey": "GENERATE_A_PRIVATE_KEY_WITH_AT_LEAST_32_CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "ImageKit": {
      "PublicKey": "YOUR_IMAGEKIT_PUBLIC_KEY",
      "PrivateKey": "SET_IMAGEKIT_PRIVATE_KEY_IN_ENV_OR_USER_SECRETS",
      "UrlEndpoint": "https://ik.imagekit.io/YOUR_IMAGEKIT_ID",
      "UploadEndpoint": "https://upload.imagekit.io/api/v1/files/upload"
    }
  },
  "Cors": {
    "DashboardOrigins": [
      "https://admin.mealmate.app",
      "https://restaurant.mealmate.app"
    ]
  },
  "ClientUrls": {
    "AdminDashboard": "https://admin.mealmate.app"
  },
  "Swagger": {
    "Enabled": true
  },
  "Otp": {
    "WhatsAppFixedCode": "123456",
    "AllowFixedCodeOutsideDevelopment": true
  },
  "Database": {
    "ApplyMigrations": false
  },
  "BackgroundJobs": {
    "SubscriptionsEnabled": true
  },
  "Seed": {
    "Identity": false
  },
  "GoogleMaps": {
    "ApiKey": "SET_VIA_ENV_GOOGLE_MAPS_SERVER_API_KEY",
    "GeocodeBaseUrl": "https://maps.googleapis.com/maps/api/geocode/json"
  },
  "Payments": {
    "PublicBaseUrl": "https://maelmate.runasp.net",
    "BootstrapPayzah": {
      "PrivateKey": "",
      "IsSandbox": true
    }
  }
