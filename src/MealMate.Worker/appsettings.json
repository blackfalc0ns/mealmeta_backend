{
  "ConnectionStrings": {
    "MealMateDb": "Host=localhost;Port=5432;Database=mealmate;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "https://api.mealmate.local",
    "Audience": "mealmate-clients",
    "SecretKey": "CHANGE_ME_use_user_secrets_or_env_minimum_32_chars",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
